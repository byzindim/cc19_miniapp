# Порт backend + статики мини-приложения
PORT=3000

# MySQL (та же база, что у max_bot)
DATABASE_URL=mysql://user:password@host:3306/database

# Токен MAX-бота (для отправки отзывов администратору и рассылки подписчикам)
MAX_BOT_TOKEN=

# ID администратора в MAX, куда приходят отзывы
MAX_ADMIN_ID=

# ID канала MAX, посты которого нужно рассылать подписчикам
MAX_CHANNEL_ID=-69548267582878

# Секрет webhook (заголовок x-max-bot-api-secret)
WEBHOOK_SECRET=

# Публичный URL мини-приложения (используется в приветственном сообщении бота)
MINIAPP_URL=https://cc19.ru

# Ссылка на бота/мини-приложение для шеринга
MAX_BOT_LINK=https://max.ru/cc19_nsk_bot
